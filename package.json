    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
